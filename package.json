{
  "name": "crowfoot-monorepo",
  "private": true,
  "version": "0.0.1",
  "devDependencies": {
    "@types/node": "22.18.11",
    "@vitest/coverage-v8": "3.2.4",
    "concurrently": "9.2.1",
    "knip": "5.66.0",
    "lefthook": "1.13.6",
    "syncpack": "13.0.4",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "scripts": {
    "build": "turbo build",
    "create-env-files": "([ -f .env ] || touch .env) && ([ -f .env.local ] || touch .env.local)",
    "dev": "turbo dev",
    "fmt": "concurrently \"pnpm:fmt:*\"",
    "fmt:knip": "knip --fix",
    "fmt:syncpack-fix": "syncpack fix-mismatches",
    "fmt:syncpack-format": "syncpack format",
    "fmt:turbo": "turbo fmt",
    "lint": "pnpm lint:turbo && pnpm lint:syncpack && pnpm lint:knip",
    "lint:knip": "knip --treat-config-hints-as-errors",
    "lint:syncpack": "syncpack lint",
    "lint:turbo": "turbo lint",
    "prebuild": "pnpm create-env-files",
    "prelint": "pnpm create-env-files",
    "prepare": "lefthook install",
    "release": "pnpm turbo build --filter=crowfoot && pnpm --filter=crowfoot publish --access public",
    "test": "turbo test",
    "test:coverage": "vitest --coverage"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "overrides": {
      "@radix-ui/react-dialog": "1.1.15",
      "cookie": "^0.7.0",
      "esbuild": "0.25.11",
      "path-to-regexp": "8.3.0",
      "prismjs": "1.30.0",
      "undici": "7.16.0"
    }
  }
}
