{
  "name": "crowfoot",
  "description": "Command-line tool that generates a standalone web app displaying ER diagrams, with persisted table positions, canvas memos and colour coding.",
  "keywords": [
    "data-visualization",
    "entity-relationship-diagram",
    "er-diagram",
    "erd"
  ],
  "homepage": "https://github.com/Junjak-Personal/crowfoot",
  "bugs": "https://github.com/Junjak-Personal/crowfoot/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Junjak-Personal/crowfoot.git"
  },
  "license": "Apache-2.0",
  "private": false,
  "version": "0.2.3",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "crowfoot": "dist-cli/bin/cli.js"
  },
  "dependencies": {
    "@prisma/internals": "6.8.2",
    "@swc/core": "1.12.11",
    "commander": "13.1.0",
    "glob": "11.1.0",
    "ink": "6.0.1",
    "inquirer": "12.6.3",
    "neverthrow": "8.2.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "valibot": "1.4.2",
    "yoctocolors": "2.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@crowfoot/configs": "workspace:*",
    "@crowfoot/erd-core": "workspace:*",
    "@crowfoot/schema": "workspace:*",
    "@rollup/plugin-commonjs": "28.0.9",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.11",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.6.0",
    "eslint": "9.38.0",
    "happy-dom": "20.0.0",
    "rollup": "4.52.5",
    "rollup-plugin-execute": "1.1.1",
    "typed-css-modules": "0.9.1",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "scripts": {
    "build": "concurrently \"pnpm:build:*\"",
    "build:cli": "rollup -c  && pnpm run cp:prism",
    "build:vite": "vite build",
    "command:build": "node ./dist-cli/bin/cli.js erd build --input https://github.com/mastodon/mastodon/blob/main/db/schema.rb --format schemarb",
    "cp:prism": "cp ../schema/node_modules/@ruby/prism/src/prism.wasm ./dist-cli/bin/prism.wasm",
    "dev": "pnpm command:build && cp dist/schema.json public/ && concurrently \"pnpm:dev:*\"",
    "dev:app": "vite --port 5173",
    "dev:css": "tcm src --watch",
    "fmt": "concurrently \"pnpm:fmt:*\"",
    "fmt:biome": "biome check --write --unsafe .",
    "fmt:eslint": "eslint --fix .",
    "gen": "concurrently \"pnpm:gen:*\"",
    "gen:css": "tcm src",
    "lint": "concurrently \"pnpm:lint:*\"",
    "lint:biome": "biome check .",
    "lint:eslint": "echo 'ESLint disabled for cli package' || eslint .",
    "lint:tsc": "tsc --noEmit",
    "postpack": "node scripts/pack-cli.js post",
    "prepack": "node scripts/pack-cli.js pre",
    "test": "vitest run"
  },
  "files": [
    "dist-cli/**/*",
    "LICENSE",
    "NOTICE"
  ]
}
