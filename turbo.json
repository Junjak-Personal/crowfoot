{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "15",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "gen"],
      "outputs": ["dist", "dist-cli"],
      "env": [],
      "outputLogs": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "crowfoot#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "gen": {
      "dependsOn": ["^gen"],
      "outputLogs": "errors-only"
    },
    "@liam-hq/schema#gen": {
      "dependsOn": ["^gen"],
      "outputs": ["src/parser/tbls/schema.generated.ts"],
      "outputLogs": "errors-only"
    },
    "lint": {
      "dependsOn": ["gen", "^build", "^lint"],
      "outputLogs": "errors-only"
    },
    "fmt": {
      "outputLogs": "errors-only"
    },
    "test": {
      "dependsOn": ["^build", "gen"],
      "outputs": []
    }
  }
}
